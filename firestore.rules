// ==========================================================
// Firestoreのセキュリティルール(参考用)
//
// Firebaseコンソール → Firestore Database → ルール タブに
// この内容を貼り付けて「公開」してください。
//
// 「匿名認証でサインインしている人だけ読み書きできる」設定です。
// アプリ側で自動的に匿名サインインするので、
// Authentication → Sign-in method → 匿名 を有効にしておく必要があります。
// ==========================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
